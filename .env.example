# Required — get from BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Required — base URL of the 8OS orchestrator service (no trailing slash)
# Local dev example: http://localhost:8080
# Docker Compose example: http://orchestrator:8080
ORCHESTRATOR_URL=http://orchestrator:8080

# Optional — bearer token for orchestrator auth (leave blank if not configured)
ORCHESTRATOR_API_KEY=
